# =============================================================================
# LLM API 配置
# =============================================================================
# 修改以下三个值来切换 LLM 提供商
#
# DeepSeek 示例:
#   LLM_API_KEY=sk-xxxxxxxx
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#
# OpenAI 示例:
#   LLM_API_KEY=sk-xxxxxxxx
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o
#
# SiliconFlow 示例:
#   LLM_API_KEY=xxxxxxxx
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=deepseek-ai/DeepSeek-V3
# =============================================================================

LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# =============================================================================
# Materials Project API 配置
# =============================================================================
# 获取 API Key: https://next.materialsproject.org/keys
MP_API_KEY=your_mp_api_key_here

# =============================================================================
# MatterGen 配置
# =============================================================================
MATTERGEN_ENABLED=true

# RTX 3090 24GB 推荐配置：单任务串行、单批最多 8 个、自动拆分批次。
# MATTERGEN_ARTIFACT_ROOT=/absolute/path/to/backend/artifacts/generation
MATTERGEN_MAX_CONCURRENCY=1
MATTERGEN_MAX_BATCH_SIZE=8
MATTERGEN_JOB_RETENTION_DAYS=7
MATTERGEN_WORKER_TIMEOUT_SECONDS=14400
MATTERGEN_CUDA_ALLOC_CONF=expandable_segments:True
MATTERGEN_TORCH_MATMUL_PRECISION=high

# Apple Silicon 上运行 MatterGen 时需要允许不支持的算子回退到 CPU。
PYTORCH_ENABLE_MPS_FALLBACK=1
